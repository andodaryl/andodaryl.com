{
	"main": "dist/_worker.js/index.js",
	"name": "andodaryl_main",
  "compatibility_date": "2026-02-19",
  "routes": [
	{
		"pattern": "andodaryl.com",
		"custom_domain": true	
	}	  
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  }
}
